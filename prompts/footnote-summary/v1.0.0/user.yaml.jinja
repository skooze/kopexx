request:
  task: summarize_canonical_footnote
  prompt_version: "{{ prompt_version }}"
filing:
  cik: "{{ cik }}"
  accession: "{{ accession }}"
  form: "{{ form }}"
  period_end: "{{ period_end }}"
footnote:
  id: "{{ footnote_id }}"
  number: "{{ footnote_number }}"
  title: {{ footnote_title }}
source_blocks:
{%- for block in source_blocks %}
  - id: "{{ block.id }}"
    type: {{ block.type }}
    text: |
{{ block.text | indent(6, true) }}
{%- endfor %}
{%- if tables %}
tables:
{%- for table in tables %}
  - id: "{{ table.id }}"
    title: {{ table.title }}
    unit: {{ table.unit }}
    columns:
{%- for column in table.columns %}
      - {{ column }}
{%- endfor %}
    rows:
{%- for row in table.rows %}
      - {{ row }}
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- if related_facts %}
related_facts:
{%- for fact in related_facts %}
  - id: "{{ fact.id }}"
    concept: {{ fact.concept }}
    value: {{ fact.value }}
    unit: {{ fact.unit }}
    period_end: "{{ fact.period_end }}"
{%- endfor %}
{%- endif %}
{%- if prior_period_summary %}
prior_period_summary: |
{{ prior_period_summary | indent(2, true) }}
{%- endif %}
instructions:
  summarize_every_supplied_source_block: true
  cite_material_claims: true
  outside_knowledge_allowed: false
  invent_values_allowed: false
