# SEC access. Startup FAILS if SEC_USER_AGENT is missing, is a library default, or has no email.
SEC_USER_AGENT="FinTek Research your-name@example.com"
SEC_GLOBAL_RPS=6
SEC_EFTS_RPS=1
SEC_THROTTLE_COOLDOWN_S=600

# Storage
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./var/objects
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=fintek-raw
# STORAGE_ENDPOINT_URL=http://localhost:9000

# NO DATABASE, AND NO REDIS. Both were configured here, and both are gone.
#
#   DATABASE_URL, TEST_DATABASE_URL and INTEGRATION_TEST_DATABASE_URL named an application
#   PostgreSQL schema built around a deterministic parser that has been withdrawn. The ORM, the
#   migrations, the disposable-database machinery and every test that opened a connection are
#   deleted. No module in this repository imports a database driver, so a variable naming one would
#   configure nothing at all.
#
#   REDIS_URL described a cache for artifacts that do not exist yet.
#
# NEITHER IS HELD IN RESERVE. Persistence follows measured model output, not the other way round —
# guessing it early is what produced the schema that had to be withdrawn. The approved-artifact
# store and its 24-hour Redis acceleration layer are specified in roadmap.md and are built when
# there is something real to store; whatever they need is added here then.

# Model gateway. provider=mock requires no credentials and performs no network calls. NO REAL
# PROVIDER ADAPTER EXISTS AND NO MODEL HAS EVER BEEN INVOKED.
#
# The product selects four model roles independently — parsing, image, summary, analysis/chat — and
# these two settings predate that decision. They are deliberately left as they are rather than
# replaced with a guessed four-role shape: the real catalog is built from verified live capability
# discovery, which has not run.
LLM_PROVIDER=mock
LLM_STANDARD_MODEL_ID=mock-model-v1
LLM_ANALYSIS_MODEL_ID=mock-model-v1

# AWS. THESE TWO ARE THE ONLY AWS SETTINGS, AND NEITHER IS SECRET.
#
# There is deliberately no placeholder for an access key, secret key, or session token. Kopexx
# never creates, accepts, manages, persists, logs, or transports raw AWS credentials; the SDK's
# default provider chain resolves and refreshes temporary ones — from a federated login on a
# workstation, an IAM role on a workload, or an OIDC-assumed role in CI. An empty placeholder is
# not neutral: it documents an unsafe design as the expected one and invites you to fill it in.
#
# Locally, authenticate through an approved external federated credential provider and select the
# resulting profile below. rules.md section 3, AWS-IDENTITY-AND-SECRETS-INVARIANT;
# docs/security/aws-identity-and-secrets.md for the full design.
AWS_REGION=us-east-1
# AWS_PROFILE=your-local-profile-name

# Parser-review application (Phase 2). `make review` starts it.
#
# LOOPBACK IS THE DEFAULT AND LEAVING IT IS A DELIBERATE ACT. `ReviewSettings` REFUSES to construct
# a non-loopback configuration without REVIEW_DEV_SECRET, so the unsafe combination cannot be
# reached by forgetting a flag. There is deliberately no placeholder for that secret below: an
# empty placeholder documents an unsafe design as the expected one and invites you to fill it in,
# which is the same reason no AWS credential variable appears in this file.
REVIEW_BIND_HOST=127.0.0.1
REVIEW_BIND_PORT=8765
# REVIEW_DEV_SECRET=            # required ONLY when binding beyond loopback; keep it out of git
REVIEW_AUTHOR=local-developer   # a LABEL on evaluation comments, never a personal identity
EVALUATION_ROOT=./var/evaluation-runs
PROMPT_DIRECTORY=./prompts/parser
CAPABILITY_SNAPSHOT=./docs/llm/bedrock-capability-snapshot.yaml
CORPUS_MANIFEST=./var/research-corpus/meta/filings.json

# THE CUMULATIVE CEILING, enforced before every billable call and settled after it. The spend
# journal in EVALUATION_ROOT survives a restart, so this is a real ceiling and not a per-process
# suggestion.
COST_CEILING_USD=5.00

# THE PHASE CEILING, enforced against the SAME durable journal. Phase 2 spent USD 0.40711113
# against it; a phase label lets the currently authorized task carry its own ceiling instead of
# that being an arithmetic note in a report. Both apply and the tighter one wins. Leave
# PHASE_COST_CEILING_USD unset for no phase ceiling — there is deliberately no default, because a
# default here would be a spending limit nobody authorized.
SPEND_PHASE=2.1
PHASE_COST_CEILING_USD=5.00

# WHAT ONE FILING'S MULTIPART PARSE MAY SPEND across every call it queues. A model-directed parse
# can queue a dozen billable calls off one plan, and without this a single filing that planned
# ambitiously could consume the whole authorization. The queue PAUSES with the reason visible when
# the next conservative reservation would not fit; nothing is shrunk or dropped to make it fit.
MULTIPART_FILING_BUDGET_USD=1.00

# OPERATIONAL SAFETY LIMITS, never statements about what filings contain. A depth limit does not
# say a filing has at most four levels of structure; it says this system stops spending on a branch
# that keeps asking to go deeper, records why, and waits for a person.
MULTIPART_MAX_DEPTH=4
MULTIPART_RECONCILIATION_CYCLES=3

# One billable invocation at a time. Five expensive filings launched concurrently is a fivefold
# multiplication of the worst case against the ceiling above.
MAX_CONCURRENT_INVOCATIONS=1

# Whether a run may fetch a missing filing member from SEC. Local storage is always checked and
# hash-verified first; this governs only what happens when a member is genuinely absent.
ALLOW_SEC_FETCH=true

ENVIRONMENT=local
LOG_LEVEL=INFO
