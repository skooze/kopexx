# SEC access. Startup FAILS if SEC_USER_AGENT is missing, is a library default, or has no email.
SEC_USER_AGENT="FinTek Research your-name@example.com"
SEC_GLOBAL_RPS=6
SEC_EFTS_RPS=1
SEC_THROTTLE_COOLDOWN_S=600

# Storage
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./var/objects
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=fintek-raw
# STORAGE_ENDPOINT_URL=http://localhost:9000

# Database. THREE URLS, THREE PURPOSES, AND NO FALLBACK BETWEEN THEM.
#
#   DATABASE_URL                   the application database. Holds real loaded facts. No test
#                                  reads or writes it, and ordinary CI does not set it at all.
#   TEST_DATABASE_URL              a DISPOSABLE database. The migration round trip drops every
#                                  table in it.
#   INTEGRATION_TEST_DATABASE_URL  a SECOND disposable database. The persistence integration
#                                  suites load, query and clean it.
#
# The two disposable databases are separate on purpose. `downgrade base` in the first would delete
# the schema the second is loading into, and which suite lost would depend on ordering — an
# intermittent failure is harder to diagnose than either suite failing outright.
#
# Each must name a different database from the other two and carry `test` as a whole
# underscore-delimited token. An unset one fails closed at the call site; none of them ever falls
# back to another.
#
# None carries a password. Locally, PostgreSQL uses peer authentication over the Unix socket, so
# the URL is a role name and a socket path — nothing secret. A deployment supplies its own
# mechanism through the environment; never write a credential into a file in this repository.
DATABASE_URL=postgresql+psycopg://fintek@/fintek?host=/run/postgresql
TEST_DATABASE_URL=postgresql+psycopg://fintek@/fintek_test?host=/run/postgresql
INTEGRATION_TEST_DATABASE_URL=postgresql+psycopg://fintek@/fintek_integration_test?host=/run/postgresql

# Cache and coordination
REDIS_URL=redis://localhost:6379/0

# Model gateway. provider=mock requires no credentials and performs no network calls.
LLM_PROVIDER=mock
LLM_STANDARD_MODEL_ID=mock-model-v1
LLM_ANALYSIS_MODEL_ID=mock-model-v1

# AWS. THESE TWO ARE THE ONLY AWS SETTINGS, AND NEITHER IS SECRET.
#
# There is deliberately no placeholder for an access key, secret key, or session token. Kopexx
# never creates, accepts, manages, persists, logs, or transports raw AWS credentials; the SDK's
# default provider chain resolves and refreshes temporary ones — from a federated login on a
# workstation, an IAM role on a workload, or an OIDC-assumed role in CI. An empty placeholder is
# not neutral: it documents an unsafe design as the expected one and invites you to fill it in.
#
# Locally, authenticate through an approved external federated credential provider and select the
# resulting profile below. rules.md section 3, AWS-IDENTITY-AND-SECRETS-INVARIANT;
# docs/security/aws-identity-and-secrets.md for the full design.
AWS_REGION=us-east-1
# AWS_PROFILE=your-local-profile-name

ENVIRONMENT=local
LOG_LEVEL=INFO
