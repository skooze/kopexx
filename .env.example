# SEC access. Startup FAILS if SEC_USER_AGENT is missing, is a library default, or has no email.
SEC_USER_AGENT="FinTek Research your-name@example.com"
SEC_GLOBAL_RPS=6
SEC_EFTS_RPS=1
SEC_THROTTLE_COOLDOWN_S=600

# Storage
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./var/objects
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=fintek-raw
# STORAGE_ENDPOINT_URL=http://localhost:9000

# NO DATABASE, AND NO REDIS. Both were configured here, and both are gone.
#
#   DATABASE_URL, TEST_DATABASE_URL and INTEGRATION_TEST_DATABASE_URL named an application
#   PostgreSQL schema built around a deterministic parser that has been withdrawn. The ORM, the
#   migrations, the disposable-database machinery and every test that opened a connection are
#   deleted. No module in this repository imports a database driver, so a variable naming one would
#   configure nothing at all.
#
#   REDIS_URL described a cache for artifacts that do not exist yet.
#
# NEITHER IS HELD IN RESERVE. Persistence follows measured model output, not the other way round —
# guessing it early is what produced the schema that had to be withdrawn. The approved-artifact
# store and its 24-hour Redis acceleration layer are specified in roadmap.md and are built when
# there is something real to store; whatever they need is added here then.

# Model gateway. provider=mock requires no credentials and performs no network calls. NO REAL
# PROVIDER ADAPTER EXISTS AND NO MODEL HAS EVER BEEN INVOKED.
#
# The product selects four model roles independently — parsing, image, summary, analysis/chat — and
# these two settings predate that decision. They are deliberately left as they are rather than
# replaced with a guessed four-role shape: the real catalog is built from verified live capability
# discovery, which has not run.
LLM_PROVIDER=mock
LLM_STANDARD_MODEL_ID=mock-model-v1
LLM_ANALYSIS_MODEL_ID=mock-model-v1

# AWS. THESE TWO ARE THE ONLY AWS SETTINGS, AND NEITHER IS SECRET.
#
# There is deliberately no placeholder for an access key, secret key, or session token. Kopexx
# never creates, accepts, manages, persists, logs, or transports raw AWS credentials; the SDK's
# default provider chain resolves and refreshes temporary ones — from a federated login on a
# workstation, an IAM role on a workload, or an OIDC-assumed role in CI. An empty placeholder is
# not neutral: it documents an unsafe design as the expected one and invites you to fill it in.
#
# Locally, authenticate through an approved external federated credential provider and select the
# resulting profile below. rules.md section 3, AWS-IDENTITY-AND-SECRETS-INVARIANT;
# docs/security/aws-identity-and-secrets.md for the full design.
AWS_REGION=us-east-1
# AWS_PROFILE=your-local-profile-name

ENVIRONMENT=local
LOG_LEVEL=INFO
