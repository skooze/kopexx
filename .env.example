# SEC access. Startup FAILS if SEC_USER_AGENT is missing, is a library default, or has no email.
SEC_USER_AGENT="FinTek Research your-name@example.com"
SEC_GLOBAL_RPS=6
SEC_EFTS_RPS=1
SEC_THROTTLE_COOLDOWN_S=600

# Storage
STORAGE_BACKEND=filesystem
STORAGE_ROOT=./var/objects
# STORAGE_BACKEND=s3
# STORAGE_BUCKET=fintek-raw
# STORAGE_ENDPOINT_URL=http://localhost:9000

# Database. TWO URLS, TWO PURPOSES.
#
#   DATABASE_URL       the application database. Holds real loaded facts.
#   TEST_DATABASE_URL  a DISPOSABLE database. Destructive migration tests drop every table in it,
#                      and fail closed rather than falling back if it is unset. It must name a
#                      different database from DATABASE_URL and carry `test` as a whole token.
#
# Neither carries a password. Locally, PostgreSQL uses peer authentication over the Unix socket,
# so the URL is a role name and a socket path — nothing secret. A deployment supplies its own
# mechanism through the environment; never write a credential into a file in this repository.
DATABASE_URL=postgresql+psycopg://fintek@/fintek?host=/run/postgresql
TEST_DATABASE_URL=postgresql+psycopg://fintek@/fintek_test?host=/run/postgresql

# Cache and coordination
REDIS_URL=redis://localhost:6379/0

# Model gateway. provider=mock requires no credentials and performs no network calls.
LLM_PROVIDER=mock
LLM_STANDARD_MODEL_ID=mock-model-v1
LLM_ANALYSIS_MODEL_ID=mock-model-v1
AWS_REGION=us-east-1

ENVIRONMENT=local
LOG_LEVEL=INFO
