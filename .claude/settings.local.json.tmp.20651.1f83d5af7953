{
  "permissions": {
    "allow": [
      "Bash(cat)",
      "Bash(./.venv/bin/python -c ' *)",
      "Bash(python3 -)",
      "Bash(./.venv/bin/python *)",
      "Bash(mkdir -p tests/fixtures)",
      "Bash(pkill -f \"pytest tests/unit\")",
      "Bash(echo \"EXIT=$?\")",
      "Bash(timeout 120 ./.venv/bin/ruff format --check packages tests)",
      "Bash(timeout 120 ./.venv/bin/ruff check packages tests)",
      "Bash(timeout 240 ./.venv/bin/mypy packages --ignore-missing-imports)",
      "Bash(timeout 120 ./.venv/bin/ruff check --fix packages tests)",
      "Bash(chmod +x scripts/mirror_dera.py)",
      "Bash(SEC_USER_AGENT=\"FinTek Research contact@example.com\" timeout 60 ./.venv/bin/python scripts/mirror_dera.py --dry-run)",
      "Bash(git add *)"
    ]
  }
}
